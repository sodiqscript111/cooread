{
  "name": "coreeder",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @coreeder/api",
    "dev:web": "npm run dev -w @coreeder/web",
    "dev:extension": "npm run dev -w @coreeder/extension",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}

# Postgres connection string (Supabase, Neon, local Docker, ...)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coreeder
# Set to false for a local database without TLS
DATABASE_SSL=true

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Supabase project used for sign-in. Tokens are verified against
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json unless SUPABASE_JWT_SECRET
# (legacy HS256 secret, Project Settings → API) is set.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=

# Comma-separated browser origins allowed to call the API (the web app).
# Extension requests are always allowed; they still need a signed-in user.
CORS_ORIGINS=http://localhost:5173,https://coreeeder.brimble.app

MONTHLY_EXPLANATION_LIMIT=50
# Number of proxies in front of the API (Brimble = 1). Needed for per-IP rate limits.
TRUST_PROXY=1
PORT=3000
